<view class="page">
  <view class="hud"><text class="eyebrow">OPERATOR / CONSOLE</text><text class="title sm">打手工作台</text><view class="row gap-12 mt-16"><text class="chip {{mode === 'orders' ? 'active' : ''}}" data-mode="orders" bindtap="setMode">接单大厅</text><text class="chip {{mode === 'apply' ? 'active' : ''}}" data-mode="apply" bindtap="setMode">入驻申请</text></view></view>
  <block wx:if="{{mode === 'orders'}}">
    <view class="hud quiet mt-24" wx:if="{{dashboard}}"><text class="eyebrow blue">STATUS</text><view class="between mt-12"><text>{{dashboard.application.statusLabel || '尚未提交入驻申请'}}</text><text class="status lime">{{dashboard.available ? 'ONLINE' : 'OFFLINE'}}</text></view></view>
    <view class="stack mt-24" wx:if="{{orders.length}}"><view class="hud order-card" wx:for="{{orders}}" wx:key="id"><view class="between"><text class="mono">ORDER / {{item.orderShort}}</text><text class="status {{item.statusTone}}">{{item.statusLabel}}</text></view><text class="section-title mt-12" style="display:block">{{item.serviceName}}</text><text class="muted mt-8">{{item.gameMode || '--'}} · {{item.mapName || '--'}} · 游戏 ID {{item.inGameId}}</text><view class="row gap-12 mt-16"><button class="btn btn-primary grow" wx:if="{{item.status === 'pending'}}" data-id="{{item.id}}" data-action="claim" bindtap="action">接单</button><button class="btn btn-blue grow" wx:if="{{item.status === 'assigned'}}" data-id="{{item.id}}" data-action="start" bindtap="action">开始服务</button><button class="btn btn-ghost grow" wx:if="{{item.status === 'in_progress'}}" data-id="{{item.id}}" data-action="complete" bindtap="action">申请完工</button></view></view></view>
    <view class="empty mt-24" wx:if="{{!orders.length}}">当前没有分配给你的订单，或申请尚未通过审核。</view>
  </block>
  <view class="hud quiet mt-24" wx:if="{{mode === 'apply'}}"><text class="eyebrow blue">APPLICATION</text><view class="field mt-16"><text class="field-label">游戏名</text><input class="input" data-field="gameName" bindinput="onField" placeholder="玩家称呼" /></view><view class="field mt-16"><text class="field-label">联系方式</text><input class="input" data-field="contact" bindinput="onField" placeholder="微信号或手机号" /></view><view class="field mt-16"><text class="field-label">最高段位</text><input class="input" data-field="rank" bindinput="onField" placeholder="例如 绝密 / 综合等级" /></view><view class="field mt-16"><text class="field-label">擅长模式</text><input class="input" data-field="modesText" bindinput="onField" placeholder="用逗号分隔" /></view><view class="field mt-16"><text class="field-label">自我介绍</text><textarea class="textarea" data-field="intro" bindinput="onField" placeholder="服务经验、在线时段、排班说明"></textarea></view><button class="btn btn-primary mt-24" bindtap="apply" loading="{{submitting}}" disabled="{{submitting}}">提交入驻申请</button></view>
  <view class="hud danger mt-24" wx:if="{{error}}"><text class="red">{{error}}</text><text class="muted mt-8" style="display:block">首次使用请先由管理员在管理台通过入驻申请，或者确认当前云环境已经初始化。</text></view>
</view>
