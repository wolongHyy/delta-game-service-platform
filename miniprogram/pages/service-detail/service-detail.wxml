<view class="page has-dock">
  <view class="hud" wx:if="{{loading}}"><view class="skeleton" style="height:240rpx"></view></view>
  <block wx:if="{{item}}">
    <view class="hud">
      <text class="eyebrow">SERVICE / {{item.kind === 'fighter' ? 'OPERATOR' : 'LOADOUT'}}</text>
      <view class="between mt-16"><view><text class="title sm">{{item.name}}</text><text class="muted" style="display:block">{{item.serviceTypeId || ''}}</text></view><text class="status lime"><text>●</text><text>可下单</text></text></view>
      <text class="muted mt-16" style="display:block">{{item.description}}</text>
      <view class="row wrap gap-8 mt-16"><text class="chip" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text><text class="chip">{{item.rank || '标准档'}}</text></view>
    </view>
    <view class="hud quiet mt-24">
      <text class="eyebrow blue">SERVICE BRIEF</text>
      <view class="detail-row"><text class="muted">服务单位</text><text class="mono">{{item.unit}}</text></view>
      <view class="detail-row"><text class="muted">服务方式</text><text>{{item.serviceName || '按局 / 按小时'}}</text></view>
      <view class="detail-row"><text class="muted">隐私说明</text><text>手机号仅在接单后对服务人员可见</text></view>
    </view>
    <view class="hud warn mt-24">
      <text class="eyebrow amber">ORDER RULES</text>
      <text class="muted mt-12" style="display:block">下单后进入待付款；提交付款凭证后由管理员核对到账，再进入接单池。帖子关联服务会保留成交凭证回写链路。</text>
    </view>
  </block>
  <view class="empty" wx:if="{{error}}">{{error}}</view>
  <view class="dock row gap-16" wx:if="{{item}}">
    <view class="grow"><text class="faint">单价</text><text class="price" style="display:block">¥{{item.priceText}}<small>/{{item.unit}}</small></text></view>
    <button class="btn btn-primary" style="min-width:260rpx" bindtap="order">立即下单</button>
  </view>
</view>
