<view class="page login-page">
  <view class="hud login-hero">
    <text class="eyebrow">VOID / ACCESS CONTROL</text>
    <text class="title">进入战术指挥台</text>
    <text class="muted mt-12">一次微信身份识别，后续订单、社区与客服消息自动同步。</text>
    <view class="row gap-12 mt-24">
      <view class="status lime"><text>●</text><text>微信云开发</text></view>
      <view class="status muted"><text>SECURE OPENID</text></view>
    </view>
  </view>

  <view class="hud quiet mt-24" wx:if="{{checking}}">
    <text class="eyebrow blue">HANDSHAKE</text>
    <view class="skeleton mt-16" style="height:88rpx;border-radius:10rpx"></view>
    <view class="skeleton mt-12" style="height:88rpx;border-radius:10rpx"></view>
  </view>

  <view class="hud mt-24" wx:else>
    <view class="row gap-16">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar lg" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view class="avatar-placeholder" wx:else>＋</view>
      </button>
      <view class="grow">
        <text class="field-label">玩家昵称</text>
        <input class="input" type="nickname" value="{{nickname}}" bindinput="onNicknameInput" placeholder="输入你显示在社区中的昵称" />
      </view>
    </view>
    <view class="divider mt-24 mb-12"></view>
    <view class="between">
      <view><text class="muted">微信身份</text><text class="mono mt-8" style="display:block">{{openidTail || '连接中'}}</text></view>
      <view class="status lime" wx:if="{{openid}}"><text>●</text><text>ONLINE</text></view>
    </view>
    <button class="btn btn-primary mt-24" bindtap="saveProfile" loading="{{saving}}" disabled="{{saving}}">保存并进入</button>
    <button class="btn btn-ghost mt-12" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" disabled="{{saving}}">{{phone ? '已绑定 ' + phone : '绑定手机号（下单联系）'}}</button>
    <text class="red mt-16" style="display:block" wx:if="{{error}}">{{error}}</text>
    <text class="faint mt-8" style="display:block" wx:if="{{cloudHint}}">{{cloudHint}}</text>
  </view>

  <view class="login-foot" bindtap="goSetup">
    <text class="faint mono">CLOUD ENV / 云开发设置</text>
    <text class="muted">连接并初始化自己的云环境</text>
  </view>
</view>