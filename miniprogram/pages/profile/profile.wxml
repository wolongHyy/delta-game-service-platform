<view class="page">
  <view class="hud identity" wx:if="{{user}}"><view class="row gap-16"><view class="avatar lg identity-avatar">{{nicknameInitial}}</view><view class="grow"><text class="eyebrow">PLAYER IDENTITY</text><text class="title sm" style="display:block">{{user.nickname || '未命名玩家'}}</text><text class="muted mono">{{openidTail}}</text></view></view><view class="row gap-12 mt-24"><view class="metric"><text class="mono lime">{{counts.orders || 0}}</text><text class="faint">订单</text></view><view class="metric"><text class="mono gold">{{profile.contributionScore || 0}}</text><text class="faint">贡献分</text></view><view class="metric"><text class="mono blue">{{profile.postCount || 0}}</text><text class="faint">发帖</text></view></view></view>
  <view class="hud quiet mt-24"><text class="eyebrow blue">ACCOUNT / LINKS</text><view class="menu-item" bindtap="openOrders"><text>我的订单</text><text class="faint">查看付款、服务与完工状态 →</text></view><view class="menu-item" bindtap="openCommunity"><text>社区身份</text><text class="faint">帖子、收藏、关注与贡献数据 →</text></view><view class="menu-item" bindtap="openFighter"><text>打手入驻</text><text class="faint">申请服务资格、接单与完工 →</text></view><view class="menu-item" bindtap="openSetup"><text>云开发设置</text><text class="faint">连接自己的微信云环境 →</text></view><view class="menu-item" wx:if="{{user.isAdmin}}" bindtap="openAdmin"><text class="lime">管理指挥台</text><text class="faint">订单核销、状态流转与社区审核 →</text></view></view>
  <view class="hud danger mt-24"><text class="eyebrow red">SESSION</text><view class="between mt-12"><text class="muted">当前身份仅绑定微信 OpenID</text><button class="btn btn-danger compact" bindtap="logout">退出登录</button></view></view>
  <view class="hud danger mt-24" wx:if="{{error}}"><text class="red">{{error}}</text></view>
</view>
