<view class="page">
  <view class="hud"><view class="between"><view><text class="eyebrow">SIGNALS / INBOX</text><text class="title sm" style="display:block">社区通知</text></view><text class="blue" bindtap="markAll">全部已读</text></view></view>
  <view class="stack mt-24" wx:if="{{items.length}}"><view class="hud notification {{item.isRead ? '' : 'unread'}}" wx:for="{{items}}" wx:key="id" data-post="{{item.postId}}" bindtap="open"><view class="between"><text class="status {{item.isRead ? 'muted' : 'lime'}}">{{item.type}}</text><text class="faint mono">{{item.createdAt}}</text></view><text class="mt-12" style="display:block">{{item.content}}</text></view></view>
  <view class="empty mt-24" wx:if="{{!loading && !items.length}}">暂无通知。</view>
  <view class="hud danger mt-24" wx:if="{{error}}"><text class="red">{{error}}</text></view>
</view>
