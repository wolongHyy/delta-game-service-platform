.post-avatar { display: flex; align-items: center; justify-content: center; border-color: var(--void-blue-200); background: var(--void-blue-50); color: var(--void-lime); font-family: "Cascadia Mono", monospace; font-weight: 700; }
.post-content { display: block; color: var(--void-text); line-height: 1.75; white-space: pre-wrap; }
.compact { min-height: 60rpx; padding: 0 18rpx; font-size: 23rpx; }
.comment { display: flex; gap: 14rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--void-border); }

.image-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.post-image { width: 100%; height: 190rpx; border-radius: 10rpx; background: var(--void-panel-2); }
.evidence-card { margin-top: 16rpx; padding: 20rpx; border: 1rpx solid rgba(169, 111, 11, .26); border-radius: 14rpx; background: linear-gradient(180deg, rgba(169, 111, 11, .07), rgba(169, 111, 11, .02)); }
