
.image-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.image-cell { position: relative; width: 200rpx; height: 200rpx; }
.image-thumb { width: 200rpx; height: 200rpx; border-radius: 10rpx; }
.image-remove { position: absolute; top: -12rpx; right: -12rpx; width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; border-radius: 50%; background: var(--void-red); color: #fff; font-size: 28rpx; }
.image-add { width: 200rpx; height: 200rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; border: 1rpx dashed var(--void-border); border-radius: 10rpx; color: var(--void-lime); font-size: 26rpx; }